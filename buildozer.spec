[app]
title = KavaxsGram
package.name = kavaxsgram
package.domain = org.kavaxs

source.dir = .
source.include_exts = py,png,jpg,kv,atlas,json
version = 1.0

requirements = python3,kivy==2.2.1,telethon,qrcode,pillow

orientation = portrait
fullscreen = 1
android.permissions = INTERNET
android.api = 33
android.minapi = 21
android.ndk = 25b
android.archs = arm64-v8a
